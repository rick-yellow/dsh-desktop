{
  "name": "dsh-awsome-plugin",
  "description": "DeepSeek Harness web UI plugin: a single dsh client bundle hosting multiple features (add-to-chat, and more to come)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
